# Stel waarden in als omgevingsvariabelen. .env wordt niet automatisch geladen.
# De Streamlit-app gebruikt uitsluitend lokale Ollama; geen API-key nodig.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optioneel: absolute lokale paden, standaard models/ onder de repository.
# WHISPER_MODEL_PATH=C:/pad/naar/whisper-small
# PIPER_MODEL_PATH=C:/pad/naar/nl_NL-mls-medium.onnx
# MINORS_PATH=C:/pad/naar/minors.json
# RUNTIME_DIR=C:/schrijfbare/tijdelijke/map

# Alleen de losse legacy-interface, nooit door de Streamlit-app gebruikt:
GEMINI_API_KEY=
# Kies een Gemini-model dat structured JSON-output ondersteunt.
GEMINI_MODEL=gemini-flash-latest
